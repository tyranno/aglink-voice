{
  "name": "aglink-voice",
  "displayName": "aglink 음성 — Claude Code 음성 대화",
  "description": "Claude Code 에 말로 묻고 답을 소리로 들어요. 받아쓰기(Whisper), 읽어 주기(Supertonic 목소리 10개), 등록한 목소리만 받기, \"아글링크\" 호출어가 모두 이 PC 안에서 돌아요.",
  "version": "0.3.0",
  "publisher": "aglink",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aglinkVoice.toggle",
        "title": "음성 대화 켜기/끄기",
        "category": "aglink 음성"
      },
      {
        "command": "aglinkVoice.enroll",
        "title": "내 목소리 등록 (15초)",
        "category": "aglink 음성"
      },
      {
        "command": "aglinkVoice.preview",
        "title": "지금 목소리로 시험 읽기",
        "category": "aglink 음성"
      }
    ],
    "keybindings": [
      {
        "command": "aglinkVoice.toggle",
        "key": "ctrl+alt+v"
      }
    ],
    "configuration": {
      "title": "aglink 음성",
      "properties": {
        "aglinkVoice.voice": {
          "type": "string",
          "default": "M2",
          "enum": ["M1", "M2", "M3", "M4", "M5", "F1", "F2", "F3", "F4", "F5"],
          "enumDescriptions": ["남자 1번", "남자 2번", "남자 3번", "남자 4번", "남자 5번", "여자 1번", "여자 2번", "여자 3번", "여자 4번", "여자 5번"],
          "description": "답을 읽어 주는 목소리.",
          "order": 0
        },
        "aglinkVoice.speed": {
          "type": "number",
          "default": 0.98,
          "minimum": 0.7,
          "maximum": 2,
          "description": "읽는 빠르기 (0.7~2배).",
          "order": 1
        },
        "aglinkVoice.listenMode": {
          "type": "string",
          "default": "wake",
          "enum": ["wake", "always", "manual"],
          "enumDescriptions": ["음성을 켜 두면 \"아글링크\" 라고 부를 때 대화가 시작돼요. 한동안 말이 없거나 \"그만\" 하면 다시 기다려요.", "음성을 켜면 바로 대화가 시작돼요. \"그만\" 하면 호출어를 기다려요.", "음성을 켜면 바로 대화가 시작되고, \"그만\" 하면 음성이 꺼져요."],
          "description": "듣는 방식.",
          "order": 2
        },
        "aglinkVoice.wakeIdleMin": {
          "type": "number",
          "default": 3,
          "enum": [0, 1, 3, 5, 10],
          "description": "호출어 방식에서 이만큼(분) 말이 없으면 다시 호출어를 기다려요. 0 은 계속 대화.",
          "order": 3
        },
        "aglinkVoice.wakeNames": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "maxItems": 5,
          "description": "\"아글링크\" 말고도 부를 이름 (2~8글자, 5개까지).",
          "order": 4
        },
        "aglinkVoice.wakeDefault": {
          "type": "boolean",
          "default": true,
          "description": "\"아글링크\" 로 불러도 깨어나요.",
          "order": 5
        },
        "aglinkVoice.summary": {
          "type": "boolean",
          "default": true,
          "description": "긴 답은 요점만 짧게 읽어요. \"자세히 읽어 줘\" 하면 전부 읽어요.",
          "order": 6
        },
        "aglinkVoice.textOnly": {
          "type": "boolean",
          "default": false,
          "description": "답을 읽지 않고 글로만 보여 줘요.",
          "order": 7
        },
        "aglinkVoice.speakerMin": {
          "type": "number",
          "default": 0.4,
          "minimum": 0.1,
          "maximum": 0.7,
          "description": "등록한 목소리와 얼마나 비슷해야 받을지 (높을수록 엄격). 목소리를 등록해야 쓰여요.",
          "order": 8
        },
        "aglinkVoice.barge": {
          "type": "boolean",
          "default": false,
          "description": "읽는 중에 말하면 멈추고 들어요. 스피커 소리가 마이크로 많이 들어가면 끄고 쓰세요 (헤드셋이면 켜도 좋아요).",
          "order": 9
        },
        "aglinkVoice.source": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "standalone", "desktop"],
          "enumDescriptions": ["aglink 데스크톱 앱이 켜져 있으면 그 음성을, 아니면 이 확장의 음성 엔진을 써요.", "늘 이 확장의 음성 엔진을 써요.", "늘 aglink 데스크톱 앱의 음성을 써요."],
          "description": "어느 음성을 쓸지.",
          "order": 10
        },
        "aglinkVoice.enginePath": {
          "type": "string",
          "default": "",
          "description": "음성 엔진 위치. 비워 두면 설치된 곳(%LOCALAPPDATA%\\aglink-voice\\engine\\aglink-voice-engine.exe).",
          "order": 11
        },
        "aglinkVoice.engineRoot": {
          "type": "string",
          "default": "",
          "description": "모델(models\\)과 Whisper(whisper\\)가 있는 폴더. 비워 두면 엔진 폴더의 위.",
          "order": 12
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tyranno/aglink-voice"
  }
}
